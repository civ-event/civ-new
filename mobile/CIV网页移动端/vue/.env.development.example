VITE_USE_MOCK=false
# 开发环境走 Vite proxy，避免浏览器跨域 CORS
VITE_API_BASE=/api

# Pop Epoch（mpopen）测试服活动配置（与 PC 端保持一致）
VITE_APP_SOURCE=140011140100489
VITE_APP_OLD_SOURCE=140011140100489
VITE_APP_GAME=mpopen
VITE_APP_LIMIT_LEVEL=5
VITE_APP_DEBUG=false

# 本地联调：填入 accessToken（可与 PC 端相同）后复制为 .env.development
# VITE_DEV_ACCESS_TOKEN=

# 方式2：URL 带参打开（会覆盖上面的 token 配置）
# http://localhost:5175/?player_token=你的JWT
